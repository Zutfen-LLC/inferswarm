+// Fixed transfer scratch, independent of tensor size and total retained cache bytes.
+static constexpr size_t CACHE_CHUNK_SIZE = 1024 * 1024;
+
+// A partial publication is never a lookup candidate. Crash leftovers have a dot prefix.
+class cache_stage {
+public:
+    FILE * file = nullptr;
+    std::string path;
+
+    explicit cache_stage(const char * directory) {
+        if (!directory) { return; }
+        path = (fs::path(directory) / ".rpc-stage-XXXXXX").string();
+        std::vector<char> name(path.begin(), path.end());
+        name.push_back(0);
+        int fd = mkstemp(name.data());
+        if (fd < 0) { path.clear(); return; }
+        path = name.data();
+        file = fdopen(fd, "w+b");
+        if (!file) { close(fd); }
+    }
+
+    ~cache_stage() {
+        if (file) { fclose(file); }
+        if (!path.empty()) { unlink(path.c_str()); }
+    }
+
+    void publish(const char * directory, const rpc_msg_set_tensor_hash_req & request, std::vector<uint8_t> & chunk) {
+        if (!file || fflush(file) != 0 || fsync(fileno(file)) != 0) { return; }
+        // Read back the staged file using the same bounded scratch before publication.
+        if (fseek(file, 0, SEEK_SET) != 0) { return; }
+        sha256_t digest;
+        sha256_init(&digest);
+        for (uint64_t done = 0; done < request.size;) {
+            size_t count = std::min<uint64_t>(chunk.size(), request.size - done);
+            if (fread(chunk.data(), 1, count, file) != count) { return; }
+            sha256_update(&digest, chunk.data(), count);
+            done += count;
+        }
+        uint8_t actual[SHA256_DIGEST_SIZE];
+        sha256_final(&digest, actual);
+        if (fgetc(file) != EOF || ferror(file) || memcmp(actual, request.sha256, sizeof(actual)) != 0) { return; }
+        char key[17];
+        snprintf(key, sizeof(key), "%016" PRIx64, request.hash);
+        const std::string final = (fs::path(directory) / key).string();
+        if (rename(path.c_str(), final.c_str()) != 0) { return; }
+        path.clear();
+        int fd = open(directory, O_RDONLY | O_DIRECTORY);
+        if (fd >= 0) { fsync(fd); close(fd); }
+    }
+};
