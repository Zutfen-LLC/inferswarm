{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferswarm.dev/schema/issue74/calibration-summary-1.json",
  "title": "InferSwarm issue #74 calibration-only summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "calibration_corpus_sha256", "stress_selection_sha256", "evidence_sha256", "statistical_cases", "stress_cases"],
  "properties": {
    "schema": {"const": "inferswarm.issue74.calibration-summary/1"},
    "contract_id": {"const": "inferswarm.gemma4-heterogeneous-numerical-equivalence/1"},
    "calibration_corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stress_selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "statistical_cases": {"type": "array", "minItems": 576, "maxItems": 576, "items": {"$ref": "#/$defs/case"}},
    "stress_cases": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "exact_integrity", "semantic_output", "finite", "evidence_complete", "envelopes"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[cs]74-"},
        "exact_integrity": {"const": "PASS"},
        "semantic_output": {"const": "PASS"},
        "finite": {"const": true},
        "evidence_complete": {"const": true},
        "envelopes": {"type": "object", "minProperties": 15, "maxProperties": 15, "additionalProperties": {"type": "string", "pattern": "^0x[0-9a-f.]+p[+-][0-9]+$"}}
      }
    }
  }
}
