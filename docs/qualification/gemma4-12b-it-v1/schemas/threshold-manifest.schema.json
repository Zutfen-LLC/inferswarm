{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferswarm.dev/schema/issue74/threshold-manifest-1.json",
  "title": "InferSwarm issue #74 derived threshold manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "methodology_manifest_sha256", "calibration_summary_sha256", "calibration_evidence_sha256", "stress_selection_sha256", "derivation_program_sha256", "metric_reducer", "corpus_sha256", "limits", "holdout_state", "manual_editing_or_rounding"],
  "properties": {
    "schema": {"const": "inferswarm.issue74.threshold-manifest/1"},
    "contract_id": {"const": "inferswarm.gemma4-heterogeneous-numerical-equivalence/1"},
    "methodology_manifest_sha256": {"$ref": "#/$defs/sha"},
    "calibration_summary_sha256": {"$ref": "#/$defs/sha"},
    "calibration_evidence_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha"}},
    "stress_selection_sha256": {"$ref": "#/$defs/sha"},
    "derivation_program_sha256": {"$ref": "#/$defs/sha"},
    "metric_reducer": {"const": "host-float64/full-domain/nearest-rank-higher-p99/per-case-family-max/1"},
    "corpus_sha256": {"$ref": "#/$defs/sha"},
    "limits": {"type": "object", "minProperties": 15, "maxProperties": 15, "additionalProperties": {"$ref": "#/$defs/limit"}},
    "holdout_state": {"const": "SEALED_NOT_CONSUMED"},
    "manual_editing_or_rounding": {"const": "PROHIBITED"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex": {"type": "string", "pattern": "^0x[0-9a-f.]+p[+-][0-9]+$"},
    "limit": {
      "type": "object", "additionalProperties": false,
      "required": ["statistical_max_hex", "stress_max_hex", "limit_hex", "rule", "comparison"],
      "properties": {
        "statistical_max_hex": {"$ref": "#/$defs/hex"}, "stress_max_hex": {"$ref": "#/$defs/hex"}, "limit_hex": {"$ref": "#/$defs/hex"},
        "rule": {"const": "max(statistical_max,stress_max)"}, "comparison": {"const": "observed<=limit"}
      }
    }
  }
}
