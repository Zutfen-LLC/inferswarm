+// #264 experiment-only, parsed during backend initialization before inference.
+static int ggml_vk_i264_mmv_state() {
+    static const int state = []() {
+        const char * value = getenv("GGML_VK_I264_MMV");
+        if (!value || strcmp(value, "base") == 0) { return 0; }
+        if (strcmp(value, "large") == 0) { return 1; }
+        GGML_ABORT("GGML_VK_I264_MMV must be exactly base or large");
+    }();
+    return state;
+}
