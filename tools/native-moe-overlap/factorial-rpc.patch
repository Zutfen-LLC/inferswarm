+bool rpc_dispatcher::observation_begin(is_factorial_rpc_stats * stats) {
+    if (!stats || observed.load() || sock->factorial_tcp_fd() < 0) return false;
+    synchronize(); // All earlier response-bearing items have completed.
+    *stats = {};
+    stats->begin_ns = is_factorial_io::now_ns();
+    stats->timeout_ms = 5000;
+    is_factorial_rpc_stats * expected = nullptr;
+    return observed.compare_exchange_strong(expected, stats);
+}
+
+bool rpc_dispatcher::observation_end() {
+    auto * stats = observed.load();
+    if (!stats) return false;
+    synchronize(); // Caller-owned stats and all borrowed data now quiescent.
+    stats->end_ns = is_factorial_io::now_ns();
+    observed.store(nullptr);
+    return true;
+}
