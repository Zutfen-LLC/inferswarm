+bool is_factorial_rpc_set3(ggml_backend_t backend, const is_factorial_rpc_tensor inputs[3], bool pipeline, uint32_t timeout_ms) {
+    if (!backend || !ggml_backend_is_rpc(backend) || !inputs || timeout_ms < 1 || timeout_ms > 10000) return false;
+    auto dispatcher = ((ggml_backend_rpc_context *)backend->context)->dispatcher;
+    auto * stats = dispatcher->observation();
+    if (!stats || stats->set_commands || stats->group_enqueue_ns) return false;
+    const uint64_t deadline_ns = is_factorial_io::now_ns() + uint64_t(timeout_ms) * 1000000;
+    // Validate the entire group before any staging. No immutable or foreign
+    // buffers, aliases, hash-cache probes, or arbitrary transfer sizes allowed.
+    for (int i = 0; i < 3; ++i) {
+        const auto & in = inputs[i];
+        if (!in.tensor || !in.tensor->buffer || !in.data || !in.size || in.size > 65536 ||
+            in.tensor->buffer->iface.set_tensor != ggml_backend_rpc_buffer_set_tensor ||
+            ggml_backend_buffer_get_usage(in.tensor->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS ||
+            in.offset > ggml_nbytes(in.tensor) || in.size > ggml_nbytes(in.tensor) - in.offset) return false;
+        auto * ctx = (ggml_backend_rpc_buffer_context *)in.tensor->buffer->context;
+        if (ctx->dispatcher != dispatcher) return false;
+        for (int j = 0; j < i; ++j) if (inputs[j].tensor == in.tensor) return false;
+    }
+    auto group = std::make_shared<factorial_set_group>();
+    group->deadline_ns = deadline_ns;
+    stats->pipeline = pipeline;
+    stats->timeout_ms = timeout_ms;
+    for (int i = 0; i < 3; ++i) {
+        const auto & in = inputs[i];
+        auto request = std::make_shared<rpc_msg_set_tensor_hash_req>();
+        request->tensor = serialize_tensor(in.tensor);
+        request->offset = in.offset;
+        request->size = in.size;
+        request->hash = 0; // All bounded mutable payloads are below HASH_THRESHOLD.
+        stats->sets[i].hash_begin_ns = is_factorial_io::now_ns();
+        sha256_hash(request->sha256, (const uint8_t *)in.data, in.size);
+        stats->sets[i].hash_end_ns = is_factorial_io::now_ns();
+        stats->sets[i].payload_bytes = in.size;
+        group->headers[i] = request;
+        group->frames[i] = { RPC_CMD_SET_TENSOR, request.get(), sizeof(*request),
+            in.data, in.size, true, &group->accepted[i], 1, true, {} };
+    }
+    dispatcher->set_group(std::move(group));
+    return true;
 }

