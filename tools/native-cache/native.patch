+bool rpc_server::set_tensor(socket_ptr sock) {
+    uint64_t message_size;
+    rpc_msg_set_tensor_hash_req request;
+    if (!sock->recv_data(&message_size, sizeof(message_size))
+        || message_size < sizeof(request)
+        || !sock->recv_data(&request, sizeof(request))
+        || request.size != message_size - sizeof(request)) {
+        return false;
+    }
+    ggml_context_ptr ctx { ggml_init({ggml_tensor_overhead(), nullptr, true}) };
+    ggml_tensor * tensor = cache_tensor(ctx.get(), request);
+    if (!tensor) { return false; }
+    cache_stage stage(cache_dir && request.size > HASH_THRESHOLD ? cache_dir : nullptr);
+    std::vector<uint8_t> chunk(CACHE_CHUNK_SIZE);
+    sha256_t digest;
+    sha256_init(&digest);
+    for (uint64_t done = 0; done < request.size;) {
+        size_t count = std::min<uint64_t>(chunk.size(), request.size - done);
+        if (!sock->recv_data(chunk.data(), count)) { return false; }
+        sha256_update(&digest, chunk.data(), count);
+        if (stage.file && fwrite(chunk.data(), 1, count, stage.file) != count) { return false; }
+        ggml_backend_tensor_set(tensor, chunk.data(), request.offset + done, count);
+        done += count;
+    }
+    uint8_t actual[SHA256_DIGEST_SIZE];
+    sha256_final(&digest, actual);
+    if (memcmp(actual, request.sha256, sizeof(actual)) != 0) { return false; }
+    if (stage.file) { stage.publish(cache_dir, request, chunk); }
+    uint8_t accepted = 1;
+    return send_msg(sock, &accepted, sizeof(accepted));
+}
