# InferSwarm .gitignore — documentation/bootstrap repository.
# Extend as runtime code lands; do not pre-add speculative toolchains.

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Python (for future runtime work and local scripting)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling caches
.cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local environment / secrets — never commit credentials
.env
.env.*
*.key
*.pem

# Exception: a sealed-holdout recipient certificate is a PUBLIC certificate and
# is committed evidence (it identifies the holdout recipient key so a custody
# claim can be verified). Only that exact filename is re-included — every other
# PEM, including any private key that happens to sit beside it, stays ignored.
!docs/qualification/*/sealed/recipient-certificate.pem

# Local scratch notes and benchmark working dirs (results are committed
# under docs/benchmarks/ with provenance; scratch is not)
scratch/
tmp/
