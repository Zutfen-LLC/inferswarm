+// Preserve the native tensor/type/stride/device semantics; reject overflow before any write.
+ggml_tensor * rpc_server::cache_tensor(ggml_context * ctx, const rpc_msg_set_tensor_hash_req & request) {
+    ggml_tensor * tensor = deserialize_tensor(ctx, &request.tensor);
+    if (!tensor || !tensor->buffer) { return nullptr; }
+    const uint64_t base = (uint64_t) ggml_backend_buffer_get_base(tensor->buffer);
+    const uint64_t capacity = ggml_backend_buffer_get_size(tensor->buffer);
+    const uint64_t bytes = ggml_nbytes(tensor);
+    if (request.tensor.data < base || request.tensor.data - base > capacity
+        || request.offset > bytes || request.size > bytes - request.offset
+        || request.offset > capacity - (request.tensor.data - base)
+        || request.size > capacity - (request.tensor.data - base) - request.offset) {
+        return nullptr;
+    }
+    return tensor;
+}
