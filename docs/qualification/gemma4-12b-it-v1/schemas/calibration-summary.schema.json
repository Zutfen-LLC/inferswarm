{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferswarm.dev/schema/issue74/calibration-summary-1.json",
  "title": "InferSwarm issue #74 calibration-only summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "calibration_corpus_sha256", "stress_selection_sha256", "evidence_sha256", "statistical_cases", "stress_cases"],
  "properties": {
    "schema": {"const": "inferswarm.issue74.calibration-summary/1"},
    "contract_id": {"const": "inferswarm.gemma4-heterogeneous-numerical-equivalence/1"},
    "calibration_corpus_sha256": {"$ref": "#/$defs/sha"},
    "stress_selection_sha256": {"$ref": "#/$defs/sha"},
    "evidence_sha256": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}},
    "statistical_cases": {"type": "array", "minItems": 576, "maxItems": 576, "items": {"$ref": "#/$defs/statistical_case"}},
    "stress_cases": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/stress_case"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "statistical_case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "case_sha256", "exact_integrity", "semantic_output", "finite", "evidence_complete", "envelopes"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^c74-"},
        "case_sha256": {"$ref": "#/$defs/sha"},
        "exact_integrity": {"const": "PASS"},
        "semantic_output": {"const": "PASS"},
        "finite": {"const": true},
        "evidence_complete": {"const": true},
        "envelopes": {"$ref": "#/$defs/envelopes"}
      }
    },
    "stress_case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "case_sha256", "exact_integrity", "semantic_output", "finite", "evidence_complete", "envelopes"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^p74-"},
        "case_sha256": {"$ref": "#/$defs/sha"},
        "exact_integrity": {"const": "PASS"},
        "semantic_output": {"const": "PASS"},
        "finite": {"const": true},
        "evidence_complete": {"const": true},
        "envelopes": {"$ref": "#/$defs/envelopes"}
      }
    },
    "envelopes": {
      "type": "object",
      "minProperties": 15,
      "maxProperties": 15,
      "propertyNames": {
        "enum": [
          "local-bf16-backend-operation-output:max-absolute-difference",
          "local-bf16-backend-operation-output:rms-difference",
          "local-bf16-backend-operation-output:p99-absolute-error",
          "hidden-residual-stream:max-absolute-difference",
          "hidden-residual-stream:rms-difference",
          "hidden-residual-stream:p99-absolute-error",
          "final-normalized-hidden-state:max-absolute-difference",
          "final-normalized-hidden-state:rms-difference",
          "final-normalized-hidden-state:p99-absolute-error",
          "bf16-logits:max-absolute-difference",
          "bf16-logits:rms-difference",
          "bf16-logits:p99-absolute-error",
          "fp32-consumer-logits:max-absolute-difference",
          "fp32-consumer-logits:rms-difference",
          "fp32-consumer-logits:p99-absolute-error"
        ]
      },
      "additionalProperties": {"type": "string", "pattern": "^0x[0-9a-f.]+p[+-][0-9]+$"}
    }
  }
}
