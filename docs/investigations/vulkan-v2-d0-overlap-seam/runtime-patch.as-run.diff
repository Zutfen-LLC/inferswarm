+// ---------------------------------------------------------------------------
+// V2-D0 observation seam (InferSwarm issue #219). Observation-only.
+// Inert unless GGML_VK_OBSERVE_INTERVAL is set at instance init.
+// Adds device timestamp queries inside compute command buffers that
+// already exist; adds no fences, barriers, semaphores, or host waits.
+// ---------------------------------------------------------------------------
+static bool vk_observe_interval_enabled = false;
+static std::string vk_observe_interval_path;
+
+// Append-only JSON Lines sink; opened lazily at first record.
+static void vk_observe_append_line(const std::string & line) {
+    std::ofstream out(vk_observe_interval_path,
+                      std::ios::binary | std::ios::app);
+    out << line << "\n";
+    out.flush();
+}
+
+static std::string vk_observe_json_escape(const std::string & s) {
+    std::string out;
+    for (char c : s) {
+        switch (c) {
+            case '"':  out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\n': out += "\\n";  break;
+            case '\r': out += "\\r";  break;
+            case '\t': out += "\\t";  break;
+            default:   out += c;      break;
+        }
+    }
+    return out;
+}
+
+static void vk_observe_emit_header(ggml_backend_vk_context * ctx) {
+    if (!vk_observe_interval_enabled) {
+        return;
+    }
+    std::ostringstream o;
+    o << "{\"kind\":\"header\",\"schema\":\"inferswarm.v2d0.observe-record/1\""
+      << ",\"device_label\":\"" << vk_observe_json_escape(ctx->name) << "\""
+      << ",\"device_name\":\""
+      << vk_observe_json_escape(std::string(ctx->device->properties.deviceName.data()))
+      << "\",\"device_uuid\":\"";
+    static const char hex[] = "0123456789abcdef";
+    for (uint32_t i = 0; i < VK_UUID_SIZE; i++) {
+        uint8_t b = ctx->device->observe_device_uuid[i];
+        o << hex[b >> 4] << hex[b & 0xf];
+    }
+    o << "\",\"vendor_id\":" << ctx->device->properties.vendorID
+      << ",\"device_id\":" << ctx->device->properties.deviceID
+      << ",\"pci_domain\":" << ctx->device->observe_pci_domain
+      << ",\"pci_bus\":" << ctx->device->observe_pci_bus
+      << ",\"pci_device\":" << ctx->device->observe_pci_device
+      << ",\"pci_function\":" << ctx->device->observe_pci_function
+      << ",\"timestamp_period_ns\":"
+      << ctx->device->properties.limits.timestampPeriod
+      << ",\"timestamp_valid_bits\":"
+      << ctx->device->observe_ts_valid_bits
+      << ",\"graph_computes\":" << ctx->observe_graph_computes
+      << ",\"total_ticks\":" << ctx->observe_tick_roles.size()
+      << ",\"tick_roles\":[";
+    for (size_t i = 0; i < ctx->observe_tick_roles.size(); i++) {
+        o << (i ? "," : "") << ctx->observe_tick_roles[i];
+    }
+    o << "],\"tick_graph_computes\":[";
+    for (size_t i = 0; i < ctx->observe_tick_gc.size(); i++) {
+        o << (i ? "," : "") << ctx->observe_tick_gc[i];
+    }
+    o << "],\"tick_queries\":[";
+    for (size_t i = 0; i < ctx->observe_tick_query.size(); i++) {
+        o << (i ? "," : "") << ctx->observe_tick_query[i];
+    }
+    o << "]}";
+    try {
+        vk_observe_append_line(o.str());
+    } catch (const std::exception &) {
+        // observation must never take the runtime down; a failed record
+        // makes the reducer fail closed on a missing/short file
+    }
+}
+
+static void vk_observe_write_begin_tick(ggml_backend_vk_context * ctx, const vk_context & subctx) {
+    if (!vk_observe_interval_enabled || !ctx->observe_query_pool) {
+        return;
+    }
+    if (subctx->s == nullptr || ctx->observe_query_idx + 2 > ctx->observe_query_count) {
+        return; // capacity is grown at graph-compute entry; never mid-buffer
+    }
+    subctx->s->buffer->buf.writeTimestamp(vk::PipelineStageFlagBits::eAllCommands,
+                                          ctx->observe_query_pool, ctx->observe_query_idx);
+    ctx->observe_tick_roles.push_back(0u);
+    ctx->observe_tick_gc.push_back((uint32_t) ctx->observe_graph_computes);
+    ctx->observe_tick_query.push_back(ctx->observe_query_idx);
+    ctx->observe_query_idx++;
+}
+
+static void vk_observe_write_end_tick(ggml_backend_vk_context * ctx, const vk_context & subctx) {
+    if (!vk_observe_interval_enabled || !ctx->observe_query_pool) {
+        return;
+    }
+    if (subctx->s == nullptr || ctx->observe_query_idx + 1 > ctx->observe_query_count) {
+        return;
+    }
+    subctx->s->buffer->buf.writeTimestamp(vk::PipelineStageFlagBits::eAllCommands,
+                                          ctx->observe_query_pool, ctx->observe_query_idx);
+    ctx->observe_tick_roles.push_back(1u);
+    ctx->observe_tick_gc.push_back((uint32_t) ctx->observe_graph_computes);
+    ctx->observe_tick_query.push_back(ctx->observe_query_idx);
+    ctx->observe_query_idx++;
+}
+
+// Drain: called only where the runtime itself has already waited on the
+// queue fence, so every written query has completed execution.
+// getQueryPoolResults is called WITHOUT eWait; availability bits are
+// requested per query and retained raw.  If any query is incomplete the
+// drain record says so and the reducer fails closed on it.
+static void vk_observe_drain(ggml_backend_vk_context * ctx) {
+    if (!vk_observe_interval_enabled || !ctx->observe_query_pool) {
+        return;
+    }
+    const uint32_t from = ctx->observe_drained_idx;
+    const uint32_t count = ctx->observe_query_idx - from;
+    if (count == 0) {
+        return;
+    }
+    // availability bits packed after the values: stride = sizeof(uint64_t)
+    std::vector<uint64_t> ticks(count, 0);
+    std::vector<uint64_t> avail(count, 0);
+    auto res = ctx->device->device.getQueryPoolResults(
+        ctx->observe_query_pool, from, count,
+        ticks.size() * sizeof(uint64_t), ticks.data(), sizeof(uint64_t),
+        vk::QueryResultFlagBits::e64);
+    auto res_avail = ctx->device->device.getQueryPoolResults(
+        ctx->observe_query_pool, from, count,
+        avail.size() * sizeof(uint64_t), avail.data(), sizeof(uint64_t),
+        vk::QueryResultFlagBits::e64 | vk::QueryResultFlagBits::eWithAvailability);
+    // Calibrated pair at this drain: DEVICE + CLOCK_MONOTONIC.
+    const VkCalibratedTimestampInfoEXT infos[2] = {
+        {VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_EXT, nullptr,
+         VK_TIME_DOMAIN_DEVICE_EXT},
+        {VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_EXT, nullptr,
+         VK_TIME_DOMAIN_CLOCK_MONOTONIC_EXT},
+    };
+    uint64_t values[2] = {0, 0};
+    uint64_t max_deviation = 0;
+    VkResult cal_res = VK_ERROR_FEATURE_NOT_PRESENT;
+    if (ctx->device->pfn_vkGetCalibratedTimestampsEXT) {
+        cal_res = ctx->device->pfn_vkGetCalibratedTimestampsEXT(
+            ctx->device->device, 2, infos, values, &max_deviation);
+    }
+    std::ostringstream o;
+    o << "{\"kind\":\"drain\",\"drain_index\":" << (uint64_t) ctx->observe_drain_count
+      << ",\"query_first\":" << (uint64_t) from
+      << ",\"query_count\":" << (uint64_t) count
+      << ",\"ticks\":[" << ticks[0];
+    for (uint32_t i = 1; i < count; i++) {
+        o << "," << ticks[i];
+    }
+    o << "],\"availability\":[" << avail[0];
+    for (uint32_t i = 1; i < count; i++) {
+        o << "," << avail[i];
+    }
+    o << "],\"get_query_result\":\"" << vk::to_string(res)
+      << "\",\"get_query_result_availability\":\"" << vk::to_string(res_avail)
+      << "\",\"calibration_device\":" << values[0]
+      << ",\"calibration_monotonic_ns\":" << values[1]
+      << ",\"calibration_max_deviation_ns\":" << max_deviation
+      << ",\"calibration_result\":" << (int32_t) cal_res
+      << ",\"drain_graph_computes\":" << (uint64_t) ctx->observe_graph_computes
+      << "}";
+    try {
+        vk_observe_append_line(o.str());
+    } catch (const std::exception &) {
+        // never take the runtime down
+    }
+    ctx->observe_drain_count++;
+    ctx->observe_drained_idx = ctx->observe_query_idx;
+}
 
