+void rpc_dispatcher::set_group(std::shared_ptr<factorial_set_group> group) {
+    auto msg = std::make_shared<rpc_msg>();
+    msg->cmd = RPC_CMD_SET_TENSOR;
+    msg->input_size = msg->output_size = 0;
+    msg->output = nullptr;
+    msg->group = std::move(group);
+    stamp(msg);
+    msg->observation->group_enqueue_ns = msg->enqueue_ns;
+    for (auto & v : msg->observation->sets) v.enqueue_ns = msg->enqueue_ns;
+    auto future = msg->completion.get_future();
+    GGML_ASSERT(queue.push(msg));
+    future.wait(); // Own headers and borrow immutable data through every ACK.
 }

